# Local PostgreSQL after: createdb event_mgmt && psql -d event_mgmt -f schema/01_ddl.sql -f schema/02_seed.sql
DATABASE_URL=postgresql://localhost:5432/event_mgmt

# JWT signing secret (use a long random string in production — 32+ chars)
JWT_SECRET=change-me-for-local-dev-only

# Comma-separated origins for split frontend hosting (optional for same-origin deploy)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
